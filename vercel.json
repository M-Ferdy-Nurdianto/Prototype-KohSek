{
    "version": 2,
    "builds": [
        {
            "src": "*.php",
            "use": "vercel-php@0.7.1"
        },
        {
            "src": "admin/*.php",
            "use": "vercel-php@0.7.1"
        },
        {
            "src": "assets/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/",
            "dest": "/index.php"
        },
        {
            "src": "/members",
            "dest": "/members.php"
        },
        {
            "src": "/cheki",
            "dest": "/cheki.php"
        },
        {
            "src": "/checkout",
            "dest": "/checkout.php"
        },
        {
            "src": "/receipt",
            "dest": "/receipt.php"
        },
        {
            "src": "/login",
            "dest": "/login.php"
        },
        {
            "src": "/admin/dashboard",
            "dest": "/admin/dashboard.php"
        },
        {
            "src": "/admin/orders_ots",
            "dest": "/admin/orders_ots.php"
        },
        {
            "src": "/admin/events_create",
            "dest": "/admin/events_create.php"
        },
        {
            "src": "/assets/(.*)",
            "dest": "/assets/$1"
        }
    ]
}
